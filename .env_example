# Default container settings
DOCKER_GUI_TZ=UTC
DOCKER_GUI_LANG=en_US.UTF-8

# Enter the VPS IPv4 address or hostname, SSH username, and password.
# Update the port if your SSH server listens on a different port.
DOCKER_GUI_SSH_HOST=
DOCKER_GUI_SSH_PORT=22
DOCKER_GUI_SSH_USER=
# Use single quotes to keep $ and # literal in the password.
DOCKER_GUI_SSH_PASSWORD=''
# For a new server, copy its public host key (type and key) from a trusted VPS console.
# Example source file on the VPS: /etc/ssh/ssh_host_ed25519_key.pub
DOCKER_GUI_SSH_HOST_KEY=''
